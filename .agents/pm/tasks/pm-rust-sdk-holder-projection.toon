  cargo test --locked --test cli_dispatch round11_stored_holder_and_public_retry_boundaries,project,codex-sol,"2026-11-18T17:24:27.991Z",local_mutation,fix/oracle-pm-cli-1118
  cargo test --locked --lib sdk_holder_registration_ends_with_the_cli_invocation,project,codex-sol,"2026-11-18T17:34:52.972Z",local_mutation,fix/oracle-pm-cli-1118
