  PM_NODE_CLI=missing-oracle RUST_TEST_THREADS=2 timeout 1200 cargo test --locked -j2 --test pagination_differential round5_long_intent_cursor_remains_executable,project,1200,codex-agent,"2026-11-12T13:49:00.660Z",local_mutation,oracle-pm-cli-2026-11-11
