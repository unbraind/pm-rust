  tests/support/mutation_differential.rs,project
tests[4]{command,scope,provenance{author,created_at,source_kind,source_ref}}:
  PM_RUST_REQUIRE_PUBLISHED_CLI=1 cargo test --locked --all-targets --all-features --no-fail-fast,project,codex-sol,"2026-11-18T09:58:16.490Z",local_mutation,fix/oracle-pm-cli-1118
  cargo fmt --all -- --check,project,codex-sol,"2026-11-18T09:58:23.289Z",local_mutation,fix/oracle-pm-cli-1118
  cargo clippy --locked --all-targets --all-features -- -D warnings,project,codex-sol,"2026-11-18T10:10:28.550Z",local_mutation,fix/oracle-pm-cli-1118
  cargo test --locked --test ownership_contract,project,codex-sol,"2026-11-18T11:04:44.802Z",local_mutation,fix/oracle-pm-cli-1118
docs[1]{path,scope}:
