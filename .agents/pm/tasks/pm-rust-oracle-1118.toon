  PM_RUST_REQUIRE_PUBLISHED_CLI=1 cargo +nightly-2026-08-06 llvm-cov --no-report --branch --locked --all-targets --all-features --no-fail-fast,project,codex-sol,"2026-11-18T16:54:51.209Z",local_mutation,fix/oracle-pm-cli-1118
