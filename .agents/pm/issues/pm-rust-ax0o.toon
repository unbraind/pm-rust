  - command: "env PM_NODE_CLI=\"$PWD/tests/oracle/node_modules/@unbrained/pm-cli\" PM_RUST_REQUIRE_PUBLISHED_CLI=1 cargo test --quiet --locked --test create_contract -- --test-threads=8"
    scope: project
    timeout_seconds: 600
    pm_context_mode: schema
    workspace_context_mode: source
