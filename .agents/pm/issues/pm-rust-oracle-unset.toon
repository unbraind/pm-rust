  "python3 -c 'import os, subprocess\nfrom pathlib import Path\nroot=Path.cwd()\ncandidates=list(Path('\"'\"'target/llvm-cov-target/debug/build/pm-rust'\"'\"').glob('\"'\"'*/out/build_script_build'\"'\"'))\nassert len(candidates)==1, candidates\nfor target, expected in [('\"'\"'gnu'\"'\"','\"'\"''\"'\"'),('\"'\"'msvc'\"'\"','\"'\"'cargo:rustc-link-arg-bin=pm-rust=/STACK:8388608\\n'\"'\"')]:\n    env=dict(os.environ, CARGO_CFG_TARGET_ENV=target, LLVM_PROFILE_FILE=str(root/'\"'\"'target/llvm-cov-target'\"'\"'/f'\"'\"'{root.name}-%p-%4m.profraw'\"'\"'))\n    result=subprocess.run([str(candidates[0])],env=env,text=True,capture_output=True,check=True)\n    assert result.stdout==expected, (target,result.stdout)\n    assert result.stderr=='\"'\"''\"'\"', result.stderr\n    print(f'\"'\"'build-script {target}: passed'\"'\"')\n'",project,120,codex-smallfix-1110,"2026-11-10T20:03:24.686Z",local_mutation,fix/bot-green-1108
