{"ts":"2026-08-16T01:18:44.099Z","author":"pi-agent","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.3","agent_model_source":"environment","agent_instance":"8dcb74ce2c0330177a04d090","agent_provenance":{"model":{"value":"glm-5.3","source":"environment"},"effort":null,"role":null,"topic":null},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-08-16T01:18:44.099Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-08-16T01:18:44.099Z","author":"pi-agent","text":"Regression slice on branch release-pipeline-regression-contract-tests. auditing_and_changelog_jobs_checkout_full_history walks both workflows as parsed YAML and asserts, for every job whose steps run cargo test / release-check / pm-changelog: checkout fetch-depth is 0 and fetch-tags is true. Revert-proof: dropping fetch-depth/fetch-tags from the CI release-check job checkout made the test FAIL with 'checks out with fetch-depth None; a shallow clone makes the identity audit vacuous and breaks the changelog gate'; restored, green."}]}],"before_hash":"4ccf1297cf2013808f164e27fff6d68e81bfdfb7e3cff874509de6cac1fabe35","after_hash":"75c4364fd6c870d215973e582788435aab5f364f6249945be69b156e9e4a7bcc","item_hash_version":2}
