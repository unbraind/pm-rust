{"hash_algorithm":"sha256","ts":"2026-10-05T11:05:06.690Z","author":"pi-rust-greptile2","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.3:cloud","agent_model_source":"environment","agent_instance":"20c605376fcf31997dd09cc0","agent_provenance":{"model":{"value":"glm-5.3:cloud","source":"environment"},"effort":null,"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-rust-ba8f"},{"op":"add","path":"/metadata/title","value":"Preserve .toon extra metadata key order in list output"},{"op":"add","path":"/metadata/description","value":"Native list output sorts extra metadata keys alphabetically (BTreeMap decoding in the item reader), while published PM CLI 2026.10.5 preserves the .toon file order in --full row projections. Verified byte-level against the installed reference: a task with metadata keys zebra, budget, alpha prints alpha/budget/zebra natively but zebra/budget/alpha in the reference. Existing differential fixtures never use non-alphabetical metadata, so this pre-existing divergence at HEAD is invisible to the current PR #60 suite; the new float-metadata differential test works around it with alphabetical fixture keys. Fixing this requires order-preserving metadata decoding and may affect .toon write-back formatting and history hashes."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":["conformance","read-parity","rust"]},{"op":"add","path":"/metadata/created_at","value":"2026-10-05T11:05:06.690Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-10-05T11:05:06.690Z"},{"op":"add","path":"/metadata/author","value":"pi-rust-greptile2"},{"op":"add","path":"/metadata/acceptance_criteria","value":"Full-row list output preserves .toon file metadata order byte-identically against published PM CLI 2026.10.5"},{"op":"add","path":"/metadata/parent","value":"pm-rust-u4al"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"f9e07973e8358745beaf966ae3b2e553e1825cb57424a29f4564ddf775323803","item_hash_version":3,"message":"","event_class":"substantive","record_hash_version":1,"record_hash":"773602a0929fa573caf424539a806ac75ec008646e23b5f3548b9acf110459f1"}
{"hash_algorithm":"sha256","ts":"2026-10-05T11:05:11.691Z","author":"pi-rust-greptile2","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.3:cloud","agent_model_source":"environment","agent_instance":"20c605376fcf31997dd09cc0","agent_provenance":{"model":{"value":"glm-5.3:cloud","source":"environment"},"effort":null,"role":null,"topic":null},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-10-05T11:05:11.691Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-10-05T11:05:11.691Z","author":"pi-rust-greptile2","text":"Reproduction evidence from the PR #60 review follow-up: a synthetic task with extra metadata zebra: 1, budget: 30.0, alpha: 2 (in that file order) was read with list --json --full by both real executables. The reference emits zebra/budget/alpha; native emits alpha/budget/zebra. All float values match after the JS number formatting fix, so this is purely a key-order divergence. The float-metadata regression test in PR #70's branch uses alphabetical fixture keys so the number-formatting slice stays isolated; this issue tracks the ordering fix."}]}],"before_hash":"f9e07973e8358745beaf966ae3b2e553e1825cb57424a29f4564ddf775323803","after_hash":"89739eefbf02b15493fc609dc33c5af62d482a15deb52cd514e417e80aaefd53","item_hash_version":3,"event_class":"substantive","record_hash_version":1,"record_hash":"1d71805f210446ee5e04799f729dbd3588ba45edb5993504965c2566225dd900"}
